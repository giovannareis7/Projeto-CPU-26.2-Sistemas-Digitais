module mini_cpu(
    input wire clock,
    input wire reset,
    input wire [17:0] switches,
    input wire enviar,
    input wire ligar
);

    //para guardar as instrucoes, mesmo que comece a mudar os switches no processo
    reg [17:0] instrucoes;

    //0 -> botao pressionado, 1 -> botao solto
    //Maquina de estados para o botao:

    parameter AGUARDAR = 0, PRESSIONADO = 1, CAPTURAR_INSTRUCAO = 2;
    reg [1:0] estado_atual = 0;
    reg [1:0] proximo_estado;

    //atualizar os estados
    always @(posedge clock) begin
        if(reset) estado_atual <= AGUARDAR;
        else estado_atual <= proximo_estado;
    end

    //transicao
    always @(*) begin
        proximo_estado = estado_atual; //se nao atribuir, ele pode guardar o estado anterior e interferir
        case(estado_atual)
            AGUARDAR: begin
                if(enviar == 0) proximo_estado = PRESSIONADO;
            end

            PRESSIONADO: begin
                if(enviar == 1) proximo_estado = CAPTURAR_INSTRUCAO;
            end

            CAPTURAR_INSTRUCAO: begin
                proximo_estado = AGUARDAR;
            end

            default: begin
                proximo_estado = AGUARDAR;
            end
        endcase
    end

    //capturar informacoes
    always @(posedge clock) begin
        if(reset) instrucoes <= 18'b0;
        else if(estado_atual == CAPTURAR_INSTRUCAO) instrucoes <= switches;
    end   

endmodule

